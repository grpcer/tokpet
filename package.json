{
  "name": "tokpet",
  "version": "0.1.1",
  "description": "Desktop pet that surfaces your real-time AI usage / quota / balance across providers.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "tokpet": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "public",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test public",
    "lint:fix": "eslint src test public --fix",
    "format": "prettier --write \"**/*.{ts,json,md,yml,yaml,css,html,js}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md,yml,yaml,css,html,js}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "@fastify/static": "^9.1.3",
    "bonjour-service": "^1.4.0",
    "fastify": "^5.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.10.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^2.1.0",
    "eslint": "^9.10.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.0",
    "simple-icons": "^16.21.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.6.0",
    "vitest": "^2.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "keywords": [
    "tokpet",
    "claude",
    "anthropic",
    "ai",
    "usage",
    "esp32",
    "lvgl"
  ]
}
